{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build freeglut",
            "type": "shell",
            "command": "g++",
            "args": [
                "${file}",
                "-IC:/Libraries/freeglut/include",
                "-LC:/Libraries/freeglut/lib",
                "-lfreeglut",
                "-lopengl32",
                "-lglu32",
                "-o",
                "${workspaceFolder}/app.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "detail": "Build OpenGL FreeGLUT project with MinGW-w64"
        }
    ]
}
